"""Bazel module definition for the monotempo monorepo.

This file holds what every project shares: the rule sets and the pinned Rust
and C/C++ toolchains. Each project contributes its own part of the module
(its crate_universe and crate annotations) through `include()` at the bottom.
See README.md.
"""

module(
    name = "monotempo",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "toolchains_llvm", version = "1.9.0")

###############################################################################
# Hermetic C/C++ toolchain.
#
# `cc` build scripts (libmdbx, keccak-asm, secp256k1, ...) and the final link
# step run through this toolchain instead of whatever compiler the host has.
# The same distribution provides `libclang` for bindgen invocations (e.g.
# `reth-mdbx-sys`'s build script).
#
# Keep the major version in sync with the `lib/clang/<major>/include` labels in
# the projects' `*.MODULE.bazel` and `bazel/BUILD.bazel` files.
###############################################################################

LLVM_VERSION = "20.1.7"

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = LLVM_VERSION,
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

###############################################################################
# Rust toolchain.
#
# One Rust version for every project, pinned to the workspaces' `rust-version`
# (MSRV) so that a Bazel build never depends on the host's rustup state.
###############################################################################

RUST_VERSION = "1.95.0"

RUST_EDITION = "2024"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = RUST_EDITION,
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

###############################################################################
# External crates.
#
# One crate_universe repository, `@crates`, for every project. It is rendered
# from the Bazel Cargo workspace in `bazel/cargo/`, which `bazel/generate.py`
# derives from the projects' manifests: one Cargo resolution for the whole
# monorepo, so that a project can depend on another's crates in-tree (reth on
# alloy) while both see the same external crates. `bazel/cargo/Cargo.lock` is
# that workspace's lockfile; the generator keeps it aligned with the projects'
# own lockfiles.
#
# The rendered result is pinned in `Cargo.Bazel.lock`; regenerate it with
#
#     CARGO_BAZEL_REPIN=1 bazel mod deps
#
# after running the generator whenever a `Cargo.toml` or `Cargo.lock` changes.
###############################################################################

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//bazel/cargo:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//bazel/cargo:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# External crates that a `[patch.crates-io]` entry points back into the tree
# (crates.io `alloy-evm` -> in-tree `alloy-consensus`). Generated.
include("//bazel/cargo:member_deps.MODULE.bazel")

###############################################################################
# Projects.
#
# Each project is a Cargo workspace; its crates are built from the generated
# `BUILD.bazel` files next to them. A project that needs to annotate external
# crates (patches, build-script inputs) contributes a `<project>.MODULE.bazel`.
###############################################################################

include("//reth:reth.MODULE.bazel")
