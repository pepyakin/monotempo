"""alloy's part of the monotempo Bazel module (included from //MODULE.bazel).

Rust crates are described by their `Cargo.toml` files; Bazel consumes those
through crate_universe (external crates) and through the generated
`BUILD.bazel` files (workspace crates). See `bazel/README.md`.
"""

###############################################################################
# External crates.
#
# crate_universe reads the Cargo workspace and `Cargo.lock` through the shadow
# workspace in `bazel/cargo/` (see `bazel/generate.py`) and renders one Bazel
# repository per external crate. The result is pinned in `Cargo.Bazel.lock`;
# regenerate it with
#
#     CARGO_BAZEL_REPIN=1 bazel mod deps
#
# after running the generator whenever a `Cargo.toml` or `Cargo.lock` changes.
###############################################################################

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "alloy_crates",
    cargo_lockfile = "//alloy:Cargo.lock",
    lockfile = "//alloy:Cargo.Bazel.lock",
    manifests = ["//alloy/bazel/cargo:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "alloy_crates")
