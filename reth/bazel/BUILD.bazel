load("@rules_rust//rust:defs.bzl", "rust_lint_config")
load("//bazel:workspace.bzl", "CLIPPY_LINTS", "RUSTC_CHECK_CFG", "RUSTC_LINTS", "RUSTDOC_LINTS")

package(default_visibility = ["//visibility:public"])

# `[workspace.lints]` from the root Cargo.toml, applied to every workspace crate.
rust_lint_config(
    name = "lints",
    clippy = CLIPPY_LINTS,
    rustc = RUSTC_LINTS,
    rustc_check_cfg = RUSTC_CHECK_CFG,
    rustdoc = RUSTDOC_LINTS,
)

# clang's builtin headers (`stdarg.h`, `stddef.h`, ...). bindgen must be told
# where they are because the prebuilt libclang cannot locate them itself.
# Keep the major version in sync with `llvm_version` in MODULE.bazel.
alias(
    name = "clang_builtin_headers",
    actual = "@llvm_toolchain_llvm//:lib/clang/20/include",
)

# Runner used by `process_per_test` (see process_per_test.bzl).
exports_files(["process_per_test.sh"])
