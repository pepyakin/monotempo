"""Tempo-specific annotations for the shared dependency resolution."""

tempo_annotations = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# Separate metadata and library compilations of age produce incompatible crate
# hashes (E0460 in downstream binaries). Use a single compilation for this crate.
tempo_annotations.annotation(
    crate = "age",
    repositories = ["crates"],
    disable_pipelining = True,
)
